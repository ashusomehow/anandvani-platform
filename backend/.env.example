# ── AanandVaani Backend — Environment Variables ───────────────────────────────
# Copy this file to .env and fill in your values.
# Never commit .env to git.

# Required — your OpenRouter API key (get one free at https://openrouter.ai)
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional — which free model to use (defaults shown below)
# Good free options:
#   google/gemini-2.0-flash-exp:free   ← default, excellent Hindi
#   meta-llama/llama-3.3-70b-instruct:free
#   mistralai/mistral-7b-instruct:free
OPENROUTER_MODEL=google/gemini-2.0-flash-exp:free

# Optional — Edge TTS voice (no API key needed, completely free)
# Male Hindi voices: hi-IN-MadhurNeural, hi-IN-RehaanNeural
# Female Hindi voice: hi-IN-SwaraNeural
TTS_VOICE=hi-IN-MadhurNeural
TTS_RATE=-15%
TTS_PITCH=-5Hz
